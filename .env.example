# Copiar como .env y completar. Generar SECRET_KEY con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# development | testing | production
FLASK_ENV_NAME=development
FLASK_APP=run.py

# SQL Server con autenticación de Windows (instancia Express: localhost\SQLEXPRESS; ODBC Driver 18: cambiar 17 por 18)
DATABASE_URL=mssql+pyodbc://@localhost/InOps?driver=ODBC+Driver+17+for+SQL+Server&trusted_connection=yes&TrustServerCertificate=yes

# Base de pruebas. Si se omite, pytest usa SQLite en memoria
TEST_DATABASE_URL=mssql+pyodbc://@localhost/InOps_Test?driver=ODBC+Driver+17+for+SQL+Server&trusted_connection=yes&TrustServerCertificate=yes
